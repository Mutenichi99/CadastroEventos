<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.App">
    <Application.Resources>
        <Color x:Key="Fundo">#F0F7F5</Color>
        <Color x:Key="Texto">#152C27</Color>
        <Color x:Key="Verde">#006B5B</Color>
        <Color x:Key="Linha">#CFDEDA</Color>
        <Style TargetType="ContentPage">
            <Setter Property="BackgroundColor" Value="{StaticResource Fundo}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Campo" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Linha}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
            <Setter Property="PlaceholderColor" Value="#526963" />
            <Setter Property="BackgroundColor" Value="#F0F7F5" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
            <Setter Property="BackgroundColor" Value="#F0F7F5" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="{StaticResource Verde}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
    </Application.Resources>
</Application>
